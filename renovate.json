{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "prHourlyLimit": 10,
  "git-submodules": {
    "enabled": true
  },
  "groupSingleUpdates": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update system extension images pinned in the build workflow",
      "managerFilePatterns": ["/^\\.github/workflows/build\\.ya?ml$/"],
      "matchStrings": [
        "--system-extension-image=(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["talos", "pkgs"],
      "separateMinorPatch": true
    },
    {
      "matchDepNames": ["pkgs"],
      "versioning": "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)$"
    },
    {
      "matchDepNames": ["talos", "pkgs"],
      "matchUpdateTypes": ["major", "minor"],
      "groupName": "Talos & Packages",
      "groupSlug": "talos-release",
      "commitMessageExtra": "to {{{newVersion}}}"
    },
    {
      "matchDepNames": ["talos"],
      "matchUpdateTypes": ["patch"],
      "groupName": "Talos & Packages",
      "groupSlug": "talos-patch",
      "commitMessageExtra": "to {{{newVersion}}}"
    },
    {
      "matchDepNames": ["pkgs"],
      "matchUpdateTypes": ["digest"],
      "groupName": "Talos & Packages",
      "groupSlug": "talos-patch",
      "commitMessageExtra": "to {{{newValue}}}"
    }
  ]
}
